# Build the @axis-backstage/plugin-readme-backend as an RHDH dynamic plugin OCI image

FROM node:20-alpine AS builder

WORKDIR /plugin

COPY package.json tsconfig.json .yarnrc ./
COPY src/ src/

RUN yarn install --no-immutable --ignore-engines 2>&1 | tail -5

RUN mkdir -p dist-types/src && ./node_modules/.bin/tsc --declaration --emitDeclarationOnly --outDir dist-types/src 2>&1

RUN npx backstage-cli package build 2>&1

RUN npx --yes @red-hat-developer-hub/cli@1.8.0 plugin export --no-build \
    --embed-package @axis-backstage/plugin-readme-backend 2>&1

RUN node -e " \
  const pkg = require('./dist-dynamic/package.json'); \
  const meta = [{ [pkg.name]: { \
    name: pkg.name + '-dynamic', \
    version: pkg.version, \
    backstage: pkg.backstage, \
    license: pkg.license \
  }}]; \
  const json = JSON.stringify(meta); \
  require('fs').writeFileSync('/plugin/index.json', json); \
  require('fs').writeFileSync('/plugin/annotation.txt', Buffer.from(json).toString('base64')); \
"

FROM scratch

COPY --from=builder /plugin/dist-dynamic/ backstage-plugin-readme-backend/
COPY --from=builder /plugin/index.json .
