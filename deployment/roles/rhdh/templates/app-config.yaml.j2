app:
  baseUrl: ${BACKEND_URL}
  title: Publishing House Developer Hub

auth:
  environment: production
  providers:
    oidc:
      production:
        clientId: ${AUTH__OIDC__CLIENT__ID}
        clientSecret: ${AUTH__OIDC__CLIENT__SECRET}
        metadataUrl: ${AUTH__OIDC__METADATA__URL}
        prompt: auto
        signIn:
          resolvers:
            - resolver: preferredUsernameMatchingUserEntityName
              dangerouslyAllowSignInWithoutUserInCatalog: true
  session:
    secret:
      $env: BACKEND_SECRET

backend:
  auth:
    externalAccess:
      - type: legacy
        options:
          subject: legacy-default-config
          secret: ${BACKEND_SECRET}
      - type: static
        options:
          subject: catalog-automation
          token: ${RHDH_SERVICE_TOKEN}
  baseUrl: ${BACKEND_URL}
  cors:
    origin: ${BACKEND_URL}
  reading:
    allow:
      - host: '*.{{ ocp_apps_domain }}'
      - host: raw.githubusercontent.com

catalog:
  locations:
    - target: ${PH__CATALOG__URL}
      type: url
      rules:
        - allow:
            - Location
            - Template
            - Component
  providers:
    keycloakOrg:
      default:
        baseUrl: ${KEYCLOAK__BASE__URL}
        clientId: ${KEYCLOAK__CLIENT__ID}
        clientSecret: ${KEYCLOAK__CLIENT__SECRET}
        loginRealm: ${KEYCLOAK__REALM}
        realm: ${KEYCLOAK__REALM}
        schedule:
          frequency:
            minutes: 1
          initialDelay:
            seconds: 15
          timeout:
            minutes: 3
  rules:
    - allow:
        - Domain
        - Component
        - System
        - Group
        - User
        - Resource
        - Location
        - Template
        - API

integrations:
  github:
    - host: github.com
      token: ${GITHUB_TOKEN}

permission:
  enabled: true
  rbac:
    defaultPolicy: allow
    precedingPolicy: allow
    policies-csv-file: /opt/app-root/src/rbac-policy.csv
    policyFileReload: true
    admin:
      superUsers:
        - name: group:default/rhdp-administrators

proxy:
  endpoints:
    /sonataflow:
      target: http://publishinghouseworkflow.{{ app_namespace }}.svc.cluster.local/graphql
      changeOrigin: true
      secure: false
      allowedMethods: ['POST']
    /central-api/auth/keys/exchange:
      target: http://central-api.{{ app_namespace }}.svc.cluster.local:8000/api/v1/auth/keys/exchange
      changeOrigin: true
      secure: false
      allowedMethods: ['POST']
      headers:
        Authorization: Bearer ${PH_API_KEY}
    /central-api/projects:
      target: http://central-api.{{ app_namespace }}.svc.cluster.local:8000/api/v1/projects
      changeOrigin: true
      secure: false
      allowedMethods: ['POST']
      headers:
        Authorization: Bearer ${PH_API_KEY}
    /github-api:
      target: https://api.github.com
      changeOrigin: true
      secure: true
      headers:
        Authorization: Bearer ${GITHUB_TOKEN}

scaffolder:
  defaultEnvironment:
    parameters:
      baseDomain: {{ ocp_apps_domain }}

phWorkflows:
  centralApiUrl: https://central-api-{{ app_namespace }}.{{ ocp_apps_domain }}

signInPage: oidc

techdocs:
  builder: local
  generator:
    runIn: local
  publisher:
    type: local
