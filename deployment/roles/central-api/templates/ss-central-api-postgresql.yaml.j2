apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: central-api-postgresql
  namespace: "{{ app_namespace }}"
  labels:
    app: central-api-postgresql
spec:
  replicas: 1
  serviceName: central-api-postgresql
  selector:
    matchLabels:
      app: central-api-postgresql
  template:
    metadata:
      labels:
        app: central-api-postgresql
    spec:
      containers:
        - name: postgres
          image: registry.redhat.io/rhel9/postgresql-15:latest
          ports:
            - containerPort: 5432
          env:
            - name: POSTGRESQL_USER
              valueFrom:
                secretKeyRef:
                  name: central-api-db
                  key: username
            - name: POSTGRESQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: central-api-db
                  key: password
            - name: POSTGRESQL_DATABASE
              value: "{{ central_api_db_name }}"
          volumeMounts:
            - name: data
              mountPath: /var/lib/pgsql/data
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: "{{ central_api_db_storage }}"
