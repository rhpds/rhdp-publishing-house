apiVersion: batch/v1
kind: CronJob
metadata:
  name: workflow-cleanup
  namespace: "{{ app_namespace }}"
  labels:
    app: publishing-house
    component: jobs
spec:
  schedule: "{{ workflow_cleanup_schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        metadata:
          labels:
            app: publishing-house
            job: workflow-cleanup
        spec:
          restartPolicy: OnFailure
          containers:
            - name: workflow-cleanup
              image: "{{ jobs_image }}"
              command: ["python", "/scripts/workflow-cleanup.py"]
              env:
                - name: CENTRAL_API_URL
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: CENTRAL_API_URL
                - name: PH_API_KEY
                  valueFrom:
                    secretKeyRef:
                      name: publishing-house-credentials
                      key: api-key
                - name: CLEANUP_DAYS
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: WORKFLOW_CLEANUP__DAYS
              volumeMounts:
                - name: script
                  mountPath: /scripts
                  readOnly: true
              resources:
                requests:
                  memory: 64Mi
                  cpu: 50m
                limits:
                  memory: 128Mi
                  cpu: 200m
          volumes:
            - name: script
              configMap:
                name: workflow-cleanup-script
