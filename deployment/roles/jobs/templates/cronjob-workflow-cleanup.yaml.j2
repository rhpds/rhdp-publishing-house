apiVersion: batch/v1
kind: CronJob
metadata:
  name: workflow-cleanup
  namespace: "{{ app_namespace }}"
  labels:
    app: publishing-house
    component: jobs
spec:
  schedule: "{{ workflow_cleanup_schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        metadata:
          labels:
            app: publishing-house
            job: workflow-cleanup
        spec:
          restartPolicy: OnFailure
          containers:
            - name: workflow-cleanup
              image: "{{ jobs_image }}"
              command: ["python", "/scripts/workflow-cleanup.py"]
              env:
                - name: SONATAFLOW_DB_HOST
                  value: "sonataflow-postgresql.{{ app_namespace }}.svc.cluster.local"
                - name: SONATAFLOW_DB_NAME
                  value: "{{ sonataflow_db_name }}"
                - name: SONATAFLOW_DB_USER
                  valueFrom:
                    secretKeyRef:
                      name: sonataflow-postgresql-svcbind
                      key: username
                - name: SONATAFLOW_DB_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: sonataflow-postgresql-svcbind
                      key: password
              volumeMounts:
                - name: script
                  mountPath: /scripts
                  readOnly: true
              resources:
                requests:
                  memory: 64Mi
                  cpu: 50m
                limits:
                  memory: 128Mi
                  cpu: 200m
          volumes:
            - name: script
              configMap:
                name: workflow-cleanup-script
