apiVersion: batch/v1
kind: CronJob
metadata:
  name: inactivity-checker
  namespace: "{{ app_namespace }}"
  labels:
    app: publishing-house
    component: jobs
spec:
  schedule: "{{ inactivity_checker_schedule }}"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        metadata:
          labels:
            app: publishing-house
            job: inactivity-checker
        spec:
          restartPolicy: OnFailure
          containers:
            - name: inactivity-checker
              image: "{{ jobs_image }}"
              command: ["python", "/scripts/inactivity-checker.py"]
              env:
                - name: SONATAFLOW_GRAPHQL_URL
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: SONATAFLOW_GRAPHQL_URL
                - name: GITHUB_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: publishing-house-credentials
                      key: github-token
                - name: JIRA_URL
                  valueFrom:
                    secretKeyRef:
                      name: publishing-house-credentials
                      key: jira-url
                - name: JIRA_EMAIL
                  valueFrom:
                    secretKeyRef:
                      name: publishing-house-credentials
                      key: jira-email
                - name: JIRA_API_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: publishing-house-credentials
                      key: jira-api-token
                - name: RHDH_URL
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: RHDH_INTERNAL_URL
                - name: RHDH_SERVICE_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: ph-developer-hub-env
                      key: RHDH_SERVICE_TOKEN
                - name: REVIEW_GROUP
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: INACTIVITY_CHECKER__REVIEW_GROUP
                - name: INACTIVITY_DAYS
                  valueFrom:
                    configMapKeyRef:
                      name: central-api-config
                      key: INACTIVITY_CHECKER__THRESHOLD_DAYS
              volumeMounts:
                - name: script
                  mountPath: /scripts
                  readOnly: true
              resources:
                requests:
                  memory: 64Mi
                  cpu: 50m
                limits:
                  memory: 128Mi
                  cpu: 200m
          volumes:
            - name: script
              configMap:
                name: inactivity-checker-script
