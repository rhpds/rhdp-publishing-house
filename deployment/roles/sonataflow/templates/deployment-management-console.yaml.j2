apiVersion: apps/v1
kind: Deployment
metadata:
  name: sonataflow-management-console
  namespace: "{{ app_namespace }}"
  labels:
    app: publishing-house
    component: management-console
spec:
  replicas: 1
  selector:
    matchLabels:
      app: sonataflow-management-console
  template:
    metadata:
      labels:
        app: sonataflow-management-console
    spec:
      containers:
        - name: console
          image: docker.io/apache/incubator-kie-sonataflow-management-console:main
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
              protocol: TCP
          env:
            - name: SONATAFLOW_MANAGEMENT_CONSOLE_KOGITO_ENV_MODE
              value: "DEV"
            - name: SONATAFLOW_MANAGEMENT_CONSOLE_DATA_INDEX_ENDPOINT
              value: "http://sonataflow-platform-data-index-service.{{ app_namespace }}.svc.cluster.local/graphql"
            - name: QUARKUS_HTTP_CORS
              value: "true"
            - name: QUARKUS_HTTP_CORS_ORIGINS
              value: "https://sonataflow-management-console-{{ app_namespace }}.{{ ocp_apps_domain }}"
          resources:
            requests:
              memory: 256Mi
              cpu: 100m
            limits:
              memory: 512Mi
              cpu: 500m
        - name: oauth-proxy
          image: quay.io/oauth2-proxy/oauth2-proxy:v7.7.1
          ports:
            - containerPort: 4180
              protocol: TCP
          args:
            - --http-address=0.0.0.0:4180
            - --upstream=http://localhost:8080
            - --provider=oidc
            - --oidc-issuer-url=https://keycloak-keycloak.{{ ocp_apps_domain }}/realms/{{ keycloak_realm }}
            - --client-id=sonataflow-management-console
            - --redirect-url=https://sonataflow-management-console-{{ app_namespace }}.{{ ocp_apps_domain }}/oauth2/callback
            - --email-domain=*
            - --cookie-secure=true
            - --cookie-name=_sf_console_proxy
            - --skip-provider-button=true
            - --allowed-group=rhdp-administrators
            - --oidc-groups-claim=groups
            - --ssl-insecure-skip-verify=true
            - --insecure-oidc-allow-unverified-email=true
            - --scope=openid email profile groups
          env:
            - name: OAUTH2_PROXY_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: sonataflow-console-oauth-proxy
                  key: client-secret
            - name: OAUTH2_PROXY_COOKIE_SECRET
              valueFrom:
                secretKeyRef:
                  name: sonataflow-console-oauth-proxy
                  key: cookie-secret
          resources:
            requests:
              memory: 64Mi
              cpu: 50m
            limits:
              memory: 128Mi
              cpu: 100m
